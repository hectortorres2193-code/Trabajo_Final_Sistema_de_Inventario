int generarID() {
    FILE *clientes = fopen("clientes.txt", "r");
    if (clientes == NULL) return 1;

    int id = 0;
    char linea[100];
    while (fgets(linea, sizeof(linea), clientes)) {
        id++;
    }

    fclose(clientes);
    return id + 1;
}

void guardardatos() {
    char nombre[50];
    char Mercancia[50];///variables para crear los datos de archivos
    float precio;
    int Day, mes, year;

    int id = generarID();

    printf("\n--- Nuevo Registro (ID: %d) ---\n", id);

    // Guardar cliente
    FILE *clientes = fopen("clientes.txt", "a");
    printf("Nombre del cliente: ");
    scanf("%s", nombre);
    fprintf(clientes, "ID: %d | Nombre: %s\n", id, nombre);
    fclose(clientes);

    // Guardar producto
    FILE *productos = fopen("Productos.txt", "a");
    printf("Producto: ");
    scanf("%s", Mercancia);
    printf("Precio: ");
    scanf("%f", &precio);
    fprintf(productos, "ID: %d | Producto: %s | Precio: %.2f\n", id, Mercancia, precio);
    fclose(productos);

    // Guardar fecha
    FILE *fechas = fopen("Fechas.txt", "a");
    printf("Dia: ");
    scanf("%d", &Day);
    printf("Mes: ");
    scanf("%d", &mes);//guarda la feha por 3 partes
    printf("Año: ");
    scanf("%d", &year);
    fprintf(fechas, "ID: %d | Fecha: %02d/%02d/%d\n", id, Day, mes, year);
    fclose(fechas);

    // crea la linea central
    FILE *central = fopen("central.txt", "a");
    fprintf(central, "ID: %d | Nombre: %s | Producto: %s | Precio: %.2f | Fecha: %02d/%02d/%d\n",id, nombre, Mercancia, precio, Day, mes, year);
    fclose(central);

    printf("Registro #%d guardado correctamente.\n", id);
}
