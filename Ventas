int generarID() {
    FILE *clientes = fopen("clientes.txt", "r");
    if (clientes == NULL) return 1;//////ordenar archivos

    int id = 0;
    char linea[100];
    while (fgets(linea, sizeof(linea), clientes)) {
        id++;
    }

    fclose(clientes);
    return id + 1;
}

void pedirFecha(int *dia, int *mes, int *year) {
    do {
        printf("Mes (1-12): ");/////verificar que sea fecha es decir que los dias de los meses esten bien y considera los bisiestos
        scanf("%d", mes);
        if (*mes < 1 || *mes > 12)
            printf("Error: mes invalido.\n");
    } while (*mes < 1 || *mes > 12);

    do {
        printf("Year (1582 en adelante): ");
        scanf("%d", year);
        if (*year < 1582)
            printf("Error: year invalido.\n");
    } while (*year < 1582);

    int bisiesto = (*year % 4 == 0 && *year % 100 != 0) || (*year % 400 == 0);

    int maxDias;
    if (*mes == 2)
        maxDias = bisiesto ? 29 : 28;
    else if (*mes == 4 || *mes == 6 || *mes == 9 || *mes == 11)
        maxDias = 30;
    else
        maxDias = 31;

    do {
        printf("Dia (1-%d): ", maxDias);
        scanf("%d", dia);
        if (*dia < 1 || *dia > maxDias)
            printf("Error: dia invalido para el mes %d.\n", *mes);
    } while (*dia < 1 || *dia > maxDias);
}

void guardardatos() {
    char nombre[50];////se llena el formato por completo
    char apellido[50];
    char Mercancia[50];
    float precio;
    int Day, mes, year;

    int id = generarID();
    printf("\n--- Nuevo Registro (ID: %d) ---\n", id);

    FILE *clientes = fopen("clientes.txt", "a");
    if (clientes == NULL) { printf("Error clientes.txt\n"); return; }
    printf("Nombre del cliente: ");
    scanf(" %[^\n]", nombre);
    printf("Apellido del cliente: ");
    scanf(" %[^\n]", apellido);
    fprintf(clientes, "ID: %d | Nombre: %s %s\n", id, nombre, apellido);
    fclose(clientes);

    FILE *productos = fopen("Productos.txt", "a");
    if (productos == NULL) { printf("Error Productos.txt\n"); return; }
    printf("Producto: ");
    scanf(" %[^\n]", Mercancia);
    printf("Precio: ");
    scanf("%f", &precio);
    fprintf(productos, "ID: %d | Producto: %s | Precio: %.2f\n", id, Mercancia, precio);
    fclose(productos);

    FILE *fechas = fopen("Fechas.txt", "a");
    if (fechas == NULL) { printf("Error Fechas.txt\n"); return; }
    pedirFecha(&Day, &mes, &year);
    fprintf(fechas, "ID: %d | Fecha: %02d/%02d/%d\n", id, Day, mes, year);
    fclose(fechas);

    FILE *central = fopen("central.txt", "a");
    if (central == NULL) { printf("Error central.txt\n"); return; }
    fprintf(central, "ID: %d | Nombre: %s %s | Producto: %s | Precio: %.2f | Fecha: %02d/%02d/%d\n",
            id, nombre, apellido, Mercancia, precio, Day, mes, year);
    fclose(central);

    printf("Registro #%d guardado correctamente.\n", id);
}

void imprimir(char *menor) {
    FILE *minor = fopen(menor, "r");//////////////mostar los archivos
    if (minor == NULL) {
        printf("No se pudo abrir el archivo.\n");
        return;
    }
    char linea[100];
    while (fgets(linea, sizeof(linea), minor) != NULL) {
        printf("%s", linea);
    }
    fclose(minor);
}

void Refrescar() {//////////crea el archivo centra con los nuevos datos
    FILE *clientes  = fopen("clientes.txt", "r");
    FILE *productos = fopen("Productos.txt", "r");
    FILE *fechas    = fopen("Fechas.txt", "r");
    FILE *central   = fopen("centralTemp.txt", "w");

    if (!clientes || !productos || !fechas || !central) {
        printf("Error al abrir archivos\n");
        return;
    }

    char linCli[200], linPro[200], linFec[200];
    int id;
    char nombre[100], Mercancia[50], fecha[20];
    float precio;

    while (
        fgets(linCli, sizeof(linCli), clientes) &&
        fgets(linPro, sizeof(linPro), productos) &&
        fgets(linFec, sizeof(linFec), fechas)
    ) {
        sscanf(linCli, "ID: %d | Nombre: %99[^\n]", &id, nombre);
        sscanf(linPro, "ID: %*d | Producto: %49[^|] | Precio: %f", Mercancia, &precio);
        sscanf(linFec, "ID: %*d | Fecha: %19s", fecha);

        int len = strlen(Mercancia);
        if (Mercancia[len-1] == ' ') Mercancia[len-1] = '\0';

        fprintf(central, "ID: %d | Nombre: %s | Producto: %s | Precio: %.2f | Fecha: %s\n",
                id, nombre, Mercancia, precio, fecha);
    }

    fclose(clientes);
    fclose(productos);
    fclose(fechas);
    fclose(central);

    remove("central.txt");
    rename("centralTemp.txt", "central.txt");

    printf("central.txt reconstruido correctamente.\n");
}

void actualizarclientes(int idBuscar) {///////////actualiza el archivo menor
    char nombre[50];
    char apellido[50];
    printf("\n--- Actualizar Registro (ID: %d) ---\n", idBuscar);
    printf("Nuevo nombre: ");
    scanf(" %[^\n]", nombre);
    printf("Nuevo apellido: ");
    scanf(" %[^\n]", apellido);

    FILE *orig = fopen("clientes.txt", "r");
    FILE *temp = fopen("cliTemp.txt", "w");
    if (!orig) { printf("Error: no abre clientes.txt\n"); return; }
    if (!temp) { printf("Error: no abre cliTemp.txt\n"); return; }

    char linea[100]; int id;
    while (fgets(linea, sizeof(linea), orig)) {
        sscanf(linea, "ID: %d", &id);
        if (id == idBuscar)
            fprintf(temp, "ID: %d | Nombre: %s %s\n", idBuscar, nombre, apellido);
        else
            fprintf(temp, "%s", linea);
    }
    fclose(orig); fclose(temp);
    remove("clientes.txt"); rename("cliTemp.txt", "clientes.txt");
    Refrescar();
    printf("Cliente #%d actualizado.\n", idBuscar);
}

