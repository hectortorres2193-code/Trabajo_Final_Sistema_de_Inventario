#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h> 

typedef struct {
    int   id;
    char  cliente[50];
    char  producto[50];
    int   dia;
    float precio;
    int   cantidad;
    float total;
} Venta;

Venta baseDatos[100];
int   totalRegistros = 0;

/*  PROTOTIPOS */
void menu();
void guardarDatos(); 
void copiarContenido(FILE *origen, FILE *destino);
void limpiarBuffer();
int soloLetras(const char *s);
int diaOk(int d);
void guardarArchivo(); 
void limpiarPantalla();



int main() {
    printf("--- Registro de ventas ---\n");
    
    // Ejecutamos el registro
    guardarDatos();
    limpiarPantalla();

    // Después de guardar, intentamos unir todo en el central.txt
    FILE *clientes  = fopen("clientes.txt", "r");
    FILE *productos = fopen("Productos.txt", "r");
    FILE *fechas    = fopen("Fechas.txt", "r");
    FILE *central   = fopen("central.txt", "w");

    // Solo unimos si los archivos existen
    if (clientes && productos && fechas && central) {
        fprintf(central, "--- CLIENTES ---\n");
        copiarContenido(clientes, central);
        
        fprintf(central, "\n--- PRODUCTOS ---\n");
        copiarContenido(productos, central);
        
        fprintf(central, "\n--- FECHAS ---\n");
        copiarContenido(fechas, central);

        fclose(clientes);
        fclose(productos);
        fclose(fechas);
        fclose(central);
        printf("\n[Archivo central.txt actualizado]\n");
    }

    return 0;
}

/*  IMPLEMENTACIÓN DE FUNCIONES */

void guardarDatos() {
    if (totalRegistros >= 100) { 
        printf("\n[!] Base de datos llena.\n"); 
        return; 
    }

    Venta v;
    v.id = totalRegistros ? baseDatos[totalRegistros - 1].id + 1 : 1;

    printf("\n--- NUEVA VENTA ---\n");

    printf("Nombre Cliente: ");
    scanf(" %49[^\n]", v.cliente); limpiarBuffer();
    if (!soloLetras(v.cliente)) {
        printf("[Error] El nombre solo debe tener letras. Registro cancelado.\n");
        return;
    }

    printf("Producto: ");
    scanf(" %49[^\n]", v.producto); limpiarBuffer();
    if (!soloLetras(v.producto)) {
        printf("[Error] El producto solo debe tener letras. Registro cancelado.\n");
        return; 
    }

    printf("Dia (1-31): ");
    if (scanf("%d", &v.dia) != 1 || !diaOk(v.dia)) {
        limpiarBuffer();
        printf("[Error] Dia invalido. Registro cancelado.\n");
        return; 
    }
    limpiarBuffer();

    printf("Precio unitario: $");
    if (scanf("%f", &v.precio) != 1 || v.precio <= 0) { 
        limpiarBuffer(); printf("[Error] Precio invalido.\n"); return; 
    }
    limpiarBuffer();

    printf("Cantidad: ");
    if (scanf("%d", &v.cantidad) != 1 || v.cantidad <= 0) { 
        limpiarBuffer(); printf("[Error] Cantidad invalida.\n"); return; 
    }
    limpiarBuffer();

    // Si todo salió bien, ahora sí escribimos en los archivos
    v.total = v.precio * v.cantidad;

    FILE *fCli = fopen("clientes.txt", "a");
    if(fCli) { fprintf(fCli, "%s\n", v.cliente); fclose(fCli); }

    FILE *fPro = fopen("Productos.txt", "a");
    if(fPro) { fprintf(fPro, "%s\n", v.producto); fclose(fPro); }

    FILE *fFec = fopen("Fechas.txt", "a");
    if(fFec) { fprintf(fFec, "%d\n", v.dia); fclose(fFec); }

    baseDatos[totalRegistros++] = v;
    guardarArchivo(); 

    printf("\n[OK] Venta guardada correctamente | ID: %d | Total: $%.2f\n", v.id, v.total);
}

// Revisa que el texto no tenga números
int soloLetras(const char *s) {
    if (!s[0]) return 0;
    for (int i = 0; s[i]; i++)
        if (!isalpha((unsigned char)s[i]) && s[i] != ' ') return 0;
    return 1;
}

// Revisa que el día sea válido
int diaOk(int d) { return d >= 1 && d <= 31; }

// Guarda el respaldo general
void guardarArchivo() {
    FILE *f = fopen("ventas.txt", "a");
    if (f) {
        Venta v = baseDatos[totalRegistros - 1];
        fprintf(f, "%d\t%s\t%s\t%d\t%.2f\n", v.id, v.cliente, v.producto, v.dia, v.total);
        fclose(f);
    }
}

void copiarContenido(FILE *origen, FILE *destino) {
    char linea[100];
    while (fgets(linea, sizeof(linea), origen)) {
        fprintf(destino, "%s", linea);
    }
}

void limpiarBuffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}
void limpiarPantalla() {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}
