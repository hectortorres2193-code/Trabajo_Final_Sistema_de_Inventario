void buscar(char *criterio) { // busca en central.txt cualquier coincidencia
    FILE *central = fopen("central.txt", "r");
    if (central == NULL) {
        printf("No hay registros aún.\n");
        return;
    }

    char linea[200];
    int encontrado = 0;

    printf("\n--- Resultados de búsqueda: %s ---\n", criterio);
    while (fgets(linea, sizeof(linea), central) != NULL) {
        if (strstr(linea, criterio) != NULL) { // strstr busca criterio dentro de linea
            printf("%s\n", linea);
            encontrado = 1;
        }
    }

    if (!encontrado)
        printf("No se encontraron registros con: %s\n", criterio);

    fclose(central);
}
